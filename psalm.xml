<?xml version="1.0"?>
<psalm xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="https://getpsalm.org/schema/config"
       xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
       errorLevel="1"
       findUnusedBaselineEntry="false"
       findUnusedCode="false"
       phpVersion="8.3"
>
    <issueHandlers>
        <RedundantConditionGivenDocblockType errorLevel="suppress"/>
        <RedundantCastGivenDocblockType errorLevel="suppress"/>
        <MissingOverrideAttribute errorLevel="suppress"/>
        <!-- Config parsing handles untyped YAML/env/CLI values by design; types are enforced by ValueCaster. -->
        <!-- Recipes and results of the harness protocol are JSON-like arrays by design (docs/harness-protocol.md). -->
        <MixedAssignment>
            <errorLevel type="suppress">
                <directory name="src/Module/Verification"/>
                <directory name="src/Module/Harness"/>
                <directory name="src/Module/Config"/>
                <file name="src/Module/Common/Internal/Injection/ConfigInflector.php"/>
            </errorLevel>
        </MixedAssignment>
        <MixedArgument>
            <errorLevel type="suppress">
                <directory name="src/Module/Verification"/>
                <directory name="src/Module/Config"/>
            </errorLevel>
        </MixedArgument>
        <MixedArrayAssignment>
            <errorLevel type="suppress">
                <file name="src/Module/Config/JsonSchemaGenerator.php"/>
            </errorLevel>
        </MixedArrayAssignment>
        <MixedArrayAccess>
            <errorLevel type="suppress">
                <file name="src/Module/Config/JsonSchemaGenerator.php"/>
            </errorLevel>
        </MixedArrayAccess>
        <MixedReturnStatement>
            <errorLevel type="suppress">
                <file name="src/Module/Config/JsonSchemaGenerator.php"/>
            </errorLevel>
        </MixedReturnStatement>
        <MissingConstructor>
            <errorLevel type="suppress">
                <directory name="src/Module/Config/Schema"/>
            </errorLevel>
        </MissingConstructor>
        <PropertyNotSetInConstructor>
            <errorLevel type="suppress">
                <directory name="src/Command"/>
                <!-- Rector sets the services of AbstractRector through autowire(), not the constructor. -->
                <directory name="src/Rector"/>
            </errorLevel>
        </PropertyNotSetInConstructor>
        <!-- Rector rules narrow refactor(Node) to the node types they register (Rector's convention). -->
        <MoreSpecificImplementedParamType>
            <errorLevel type="suppress">
                <directory name="src/Rector"/>
            </errorLevel>
        </MoreSpecificImplementedParamType>
    </issueHandlers>
    <extraFiles>
        <!-- Loaded by Rector's own autoloader. -->
        <directory name="vendor/rector/rector/vendor/symplify/rule-doc-generator-contracts/src"/>
    </extraFiles>
    <projectFiles>
        <directory name="src"/>
        <ignoreFiles>
            <directory name="vendor"/>
            <directory name="tests"/>
        </ignoreFiles>
    </projectFiles>
    <forbiddenFunctions>
        <function name="dd"/>
        <function name="exit"/>
        <function name="die"/>
        <function name="var_dump"/>
        <function name="echo"/>
        <function name="print"/>
        <function name="trap"/>
        <function name="td"/>
        <function name="tr"/>
        <function name="dump"/>
        <function name="error_log"/>
    </forbiddenFunctions>
</psalm>
